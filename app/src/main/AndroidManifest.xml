<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- requestNetwork（Wi-Fi と無線子機の併用）に必要 -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>
    <!-- ES920LR（LoRa、CH340）を USB ホストで使う。無い端末でもインストールはできるように required=false -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false"/>
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Controller">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Controller"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:screenOrientation="landscape"> <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!-- ES920LR を挿したときにアプリを開く設定（USB_DEVICE_ATTACHED）は 2026-11-06 にここから外した。
             挿すたびにアプリが開き直されていたため。2026-11-08 から下の UsbAttachActivity で受ける -->
        </activity>
        <!-- ES920LR を挿したとき、許可ダイアログなしでこのアプリに許可を出す（2026-11-08）。
             初めて挿したときの確認で「常に」を選ぶと、次から Android が挿すたびに許可を出してからこれを開く。
             これは画面を持たずにすぐ閉じる。別のタスクにして、MainActivity（singleInstance）を開き直さない -->
        <activity
            android:name=".UsbAttachActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="com.example.controller.usbattach"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>
    </application>

</manifest>